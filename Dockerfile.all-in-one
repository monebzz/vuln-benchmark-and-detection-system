# All-in-One Monolithic Dockerfile
# Bundles Frontend (Next.js), Backend (FastAPI), LineVul (Flask/PyTorch), and PostgreSQL into a single container.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# 1. Install system utilities, PostgreSQL 16 repository & dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    lsb-release \
    build-essential \
    supervisor \
    git \
    libgomp1 \
    libpq-dev \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Add official PostgreSQL repository
RUN install -d /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    postgresql-16 \
    postgresql-client-16 \
    && rm -rf /var/lib/apt/lists/*

# Add official NodeSource Node.js 20 repository
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# 2. Install PyTorch CPU directly
RUN pip3 install --break-system-packages --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# 3. Copy Python dependencies and install
COPY backend/requirements.txt /tmp/backend_reqs.txt
COPY linevul/requirements.docker.txt /tmp/linevul_reqs.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /tmp/backend_reqs.txt -r /tmp/linevul_reqs.txt

# 4. Copy project code
COPY . /app/

# 5. Build Frontend
WORKDIR /app/frontend
RUN npm ci || npm install
RUN npm run build

WORKDIR /app

# 6. Configure Supervisor & Entrypoint
RUN mkdir -p /var/log/supervisor /etc/supervisor/conf.d
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Ports:
# 3000: Next.js Frontend
# 8001: FastAPI Backend
# 5000: LineVul AI Inference
# 5432: PostgreSQL Database
EXPOSE 3000 8001 5000 5432

ENTRYPOINT ["/entrypoint.sh"]
